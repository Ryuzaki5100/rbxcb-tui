# Maintainer: Ryuzaki5100 <Ryuzaki5100@users.noreply.github.com>
pkgname=rbxcb-tui
pkgver=__VERSION__
pkgrel=1
pkgdesc='A terminal UI for solving 3x3x3 Rubik'"'"'s cubes'
arch=('x86_64' 'aarch64')
url='https://github.com/Ryuzaki5100/rbxcb-tui'
license=('MIT')
makedepends=('go')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('__SHA256__')

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  export CGO_ENABLED=0
  go build -mod=vendor -trimpath \
    -ldflags "-s -w -X main.version=${pkgver}" \
    -o rbxcb-tui ./cmd/rbxcb-tui
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  install -Dm755 rbxcb-tui "${pkgdir}/usr/bin/rbxcb-tui"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
